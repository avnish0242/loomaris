# ─── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# App type: Web application
#
# Development:
#   Authorised JavaScript origins: http://localhost:3000
#   Authorised redirect URI:       http://localhost:8000/api/v1/auth/google/callback
#
# Production (loomaris.xyz):
#   Authorised JavaScript origins: https://loomaris.xyz  https://www.loomaris.xyz
#   Authorised redirect URI:       https://api.loomaris.xyz/api/v1/auth/google/callback
#
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create app at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: http://localhost:8000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ─── Zoho OAuth ──────────────────────────────────────────────────────────────
# Create app at: https://api-console.zoho.com → Add Client → Server-based Applications
# Authorized Redirect URI: http://localhost:8000/api/v1/auth/zoho/callback
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REDIRECT_URI=http://localhost:8000/api/v1/auth/zoho/callback

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-32-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Encryption (Fernet — for API keys + tokens at rest) ─────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://loomaris:loomaris@localhost:5432/loomaris

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Anthropic (master key — Phase 1 fallback) ───────────────────────────────
# Per-user keys stored encrypted in DB after login (POST /api/v1/auth/claude-key)
ANTHROPIC_API_KEY=sk-ant-...

# ─── LocalStack ──────────────────────────────────────────────────────────────
# Auto-populated by: make setup  (reads from 'localstack auth token')
LOCALSTACK_AUTH_TOKEN=your-localstack-auth-token

# Set by docker-compose; override here only when running locally without Docker
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_DEFAULT_REGION=us-east-1

# ─── Loomaris control-plane AWS account ──────────────────────────────────────
# 12-digit AWS account ID of the Loomaris control-plane account.
# Used to build trust policy ARN shown in org-settings AWS wizard.
# On ECS injected by Terraform; set here for local dev/prod-mode testing.
LOOMARIS_AWS_ACCOUNT_ID=

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
DOMAIN=loomaris.xyz
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
