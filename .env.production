# ─── Production environment for loomaris.xyz ─────────────────────────────────
# Copy this to .env on your server and fill in real values.
# NEVER commit a filled-in copy of this file.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
DOMAIN=loomaris.xyz
FRONTEND_URL=https://app.loomaris.xyz
BACKEND_URL=https://api.loomaris.xyz
# Superadmin is a DB-level role — grant via: make ecs-shell → python scripts/seed_superadmin.py

# ─── Google OAuth ────────────────────────────────────────────────────────────
# In Google Cloud Console → Credentials → your OAuth 2.0 Client, add:
#   Authorised JavaScript origins:
#     https://loomaris.xyz
#     https://www.loomaris.xyz
#   Authorised redirect URIs:
#     https://api.loomaris.xyz/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.loomaris.xyz/api/v1/auth/google/callback

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# In GitHub → Settings → Developer settings → OAuth Apps → your app, set:
#   Homepage URL: https://app.loomaris.xyz
#   Authorization callback URL: https://api.loomaris.xyz/api/v1/auth/github/callback
GITHUB_CLIENT_ID=Ov23ligJcd0Up22qJ7Ke
GITHUB_CLIENT_SECRET=0f9d404dc00a60bde6205ec65f6d4f92bf5e5069
GITHUB_REDIRECT_URI=https://api.loomaris.xyz/api/v1/auth/github/callback

# ─── Zoho OAuth ──────────────────────────────────────────────────────────────
# In Zoho API Console → your app → Authorized Redirect URIs, add:
#   https://api.loomaris.xyz/api/v1/auth/zoho/callback
ZOHO_CLIENT_ID=1000.FRC4GM755IDTRETDZ51JP2HTASWWOV
ZOHO_CLIENT_SECRET=95d5f3f5e941a5b46c60b55ad228483fa275c875f4
ZOHO_REDIRECT_URI=https://api.loomaris.xyz/api/v1/auth/zoho/callback

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Encryption ──────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://loomaris:REPLACE_PASSWORD@postgres:5432/loomaris

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── AWS (real account — no LocalStack in prod) ───────────────────────────────
# AWS_ENDPOINT_URL=          (leave unset to target real AWS)
AWS_ACCESS_KEY_ID=REPLACE_WITH_REAL_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_REAL_SECRET
AWS_DEFAULT_REGION=us-east-1

# ─── Loomaris control-plane AWS account ──────────────────────────────────────
# Used to build the trust policy ARN shown in the org-settings AWS wizard.
# On ECS this is injected as a plain env var by Terraform; set here for local prod mode.
LOOMARIS_AWS_ACCOUNT_ID=219602461083
